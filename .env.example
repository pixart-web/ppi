# Ambiente local PPI (copiar para .env). Não colocar segredos de produção neste ficheiro versionado.
WP_PORT=8097
MAILPIT_PORT=8098
PPI_DOMAIN=ppi.localhost
DB_PASSWORD=ppi-local
WP_ENVIRONMENT_TYPE=staging
# SMTP local (Mailpit). Em produção definir no wp-config.php ou variáveis do alojamento.
PPI_SMTP_HOST=mailpit
PPI_SMTP_PORT=1025
PPI_SMTP_USER=
PPI_SMTP_PASS=
PPI_SMTP_SECURE=
# Em staging, todas as notificações vão para este endereço de teste (nunca para contactos reais).
PPI_MAIL_TEST_TO=leads@ppi.test
# Palavra-passe opcional de pré-visualização (vazio = sem barreira).
PPI_DEMO_PASSWORD=
